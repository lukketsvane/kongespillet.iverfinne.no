{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": ["kongespillet.iverfinne.no"],
  "routes": [
    {
      "src": "/",
      "dest": "/shell.html"
    },
    {
      "src": "/__origin",
      "dest": "https://finn-harald.iver-raknes-finne.chatgpt.site/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "https://finn-harald.iver-raknes-finne.chatgpt.site/$1"
    }
  ]
}
